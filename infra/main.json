      "name": "[guid(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('containerAppName'))), variables('roleOpenAiUser'), resourceId('Microsoft.CognitiveServices/accounts', parameters('openAiAccountName')))]",
